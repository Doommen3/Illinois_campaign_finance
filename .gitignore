# macOS / editor noise
.DS_Store

# Python cache / virtualenv
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local secrets/env
.env
!.env.example

# Large local datasets and generated artifacts
Bulk_download/
data/*
output/
tmp/

# SQLite artifacts (can easily exceed GitHub file limits)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Large analytical exports
*.parquet
*.feather

# Keep curated geometry assets in version control
!data/geometry/
!data/geometry/il/
!data/geometry/il/*.json
!data/geometry/il/README.md

# Claude Code / Codex agent worktrees and session artifacts
.claude/worktrees/
.codex/

# IDE / editor config (machine-specific)
.vscode/

# Raw TIGER/Line shapefiles (build inputs, not deployment artifacts)
Maps/

# Generated visualization artifacts (rebuild via scripts/triple_pipeline_viz.py)
artifacts/

# One-off diagnostic scripts
_diag_*.py

# Agent session logs (may contain sensitive data)
rollout-*.jsonl
saved_convo/
