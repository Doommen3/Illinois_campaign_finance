# Illinois Campaign Finance Tracker — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On the server, this file lives at /srv/illinois_campaign_finance/shared/.env
# IMPORTANT: Values must have NO spaces around the '=' sign.

# FEC API key — get one free at https://api.open.fec.gov/developers/
FEC_API_KEY=

# Flask
# APP_ENV values: development, staging, production
# APP_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=false
# Footer contact (optional, shown site-wide)
# PUBLIC_CONTACT_EMAIL=you@example.com

# API
# Comma-separated API keys for /api/* access when API key auth is enabled
# API_KEYS=replace-with-long-random-key
# Force key auth even if API_KEYS is empty
# API_REQUIRE_KEY=false
# API rate limit window (per minute, per API key or per IP when unauthenticated)
# API_RATE_LIMIT_PER_MINUTE=120

# Search guardrails
# SEARCH_MIN_QUERY_LENGTH=2
# SEARCH_MAX_QUERY_LENGTH=64
# SEARCH_QUERY_TIMEOUT_MS=700
# SEARCH_SLOW_QUERY_MS=400

# Federal heavy-view caching
# FEDERAL_VIEW_CACHE_ENABLED=true
# FEDERAL_OVERVIEW_CACHE_TTL_SECONDS=900
# FEDERAL_NETWORKS_CACHE_TTL_SECONDS=600
# FEDERAL_DONOR_INTEL_CACHE_TTL_SECONDS=600
# FEDERAL_MATCHING_CACHE_TTL_SECONDS=600

# Data freshness warning thresholds (days old)
# LOCAL_DATA_STALE_DAYS=45
# FEDERAL_DATA_STALE_DAYS=14

# Database (required; PostgreSQL for local + production)
# DATABASE_URL=postgresql://your_user@localhost/ilcf
# DATABASE_PATH is legacy/deprecated and should not be used for new setups.

# Scraper rate limiting
# RATE_LIMIT_RPM=30
